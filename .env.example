# Copy this file to .env and fill it in. .env is git-ignored; never commit real keys.

# ---- server ----
PORT=8787
# A long random string. Signs sessions and hides card codes in the database.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Staff PINs, used the first time the database is created.
COUNTER_PIN=
ADMIN_PIN=

# ---- Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys) ----
# Start with TEST keys (rzp_test_...). Switch to live keys only after a full test.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add  https://YOUR-DOMAIN/api/razorpay/webhook
# with the payment.captured event, and paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# Optional
# DAILY_TARGET=10000
# TOPUP_MAX=10000

# Testing mode: no sign-in anywhere (counter, /admin, /parent). On in development, off in
# production. Set to 0 to require the real logins, 1 to force it on. Turn OFF before launch.
# HB_OPEN_ACCESS=1
